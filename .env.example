# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Usado para montar o link do magic link e o link/QR do cliente.
# Em produção: https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal usado para gravar o HASH do IP de quem se cadastra (nunca o IP em si),
# que é o que sustenta o limite de um cadastro por conexão. Sem ele o app
# funciona, mas o hash fica reversível por força bruta — defina em produção.
IP_HASH_SALT=troque-por-uma-frase-longa-e-aleatoria
