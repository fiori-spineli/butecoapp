# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de serviço (Project Settings > API > service_role). IGNORA O RLS:
# nunca use prefixo NEXT_PUBLIC_, nunca importe fora de arquivo "use server".
#
# É o que permite duas coisas que não existem mais no auto-atendimento:
# criar a conta de um bar pelo painel de admin e gravar os pedidos de contato.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Usado para montar os links de e-mail e o link/QR do cliente.
# Em produção: https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal usado para gravar o HASH do IP (nunca o IP em si), que é o que sustenta
# o limite de pedidos por conexão. Sem ele o app funciona, mas o hash fica
# reversível por força bruta — defina em produção.
IP_HASH_SALT=troque-por-uma-frase-longa-e-aleatoria

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). O CAPTCHA invisível
# do login e do formulário de contato. Sem as duas chaves o widget some e o
# formulário segue funcionando — bom para desenvolvimento, ruim para produção.
#
# A MESMA chave deve ser cadastrada no Supabase em
# Authentication > Attack Protection > Enable CAPTCHA protection (provider:
# Turnstile). É isso que protege o endpoint de auth, e não só o meu formulário.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Aviso de bar novo interessado (opcional). Sem isso o pedido só aparece no
# painel de admin. Ver lib/aviso-interesse.ts.
RESEND_API_KEY=
EMAIL_AVISO_INTERESSE=voce@exemplo.com,socio@exemplo.com
EMAIL_REMETENTE=ButecoApp <onboarding@resend.dev>
