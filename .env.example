# Copie para .env.local. Nunca publique valores reais nem use NEXT_PUBLIC_ para segredos.
DATABASE_URL=postgresql://usuario:senha@host-neon-pooler/neondb?sslmode=verify-full
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
IP_HASH_SALT=gere-outro-segredo-aleatorio
ADMIN_MFA_ENROLLMENT_KEY=gere-uma-chave-de-ativacao-com-pelo-menos-32-caracteres
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2: endpoint S3, bucket privado para escrita e domínio público de leitura.
R2_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=https://imagens.exemplo.com

# Resend: o domínio do remetente precisa estar verificado para destinatários reais.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ButecoApp <acesso@exemplo.com>
EMAIL_AVISO_INTERESSE=administrador@exemplo.com
EMAIL_REMETENTE=ButecoApp <avisos@exemplo.com>

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
